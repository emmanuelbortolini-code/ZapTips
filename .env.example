# Postgres via Supabase. Pegue a connection string em Project Settings > Database
# (ou botão "Connect" no topo do dashboard, se não achar em Settings).
# Use o pooler (porta 6543) se rodar muitas conexões curtas; direto (5432) serve para scripts.
# IMPORTANTE: em ambiente sem IPv6 (ex.: GitHub Actions) a conexão direta
# (db.xxxxx.supabase.co) falha com "Network is unreachable" - ela resolve
# só para IPv6. Use sempre o pooler (*.pooler.supabase.com, usuario vira
# postgres.<project-ref>) nesses ambientes.
DATABASE_URL=postgresql://postgres:senha@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# OddsPapi (api.oddspapi.io/v4). Autenticação é por query param, nao por header.
ODDSPAPI_API_KEY=
ODDSPAPI_BASE_URL=https://api.oddspapi.io/v4

# ESPN nao exige chave. Base configuravel so para facilitar teste com mock/proxy.
ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/soccer

# API da Anthropic, usada na Fase 3 para extracao de palpites em texto livre.
ANTHROPIC_API_KEY=

# Parametros de negocio (Fase 4 e 6). Ajustaveis sem deploy, mas o valor
# efetivo em producao deve vir daqui, nao hardcoded.
ODD_MINIMA_ABSOLUTA=1.40
MARGEM_PCT=0.04
SLATE_MAX_PICKS=5
BANCA_INICIAL_PADRAO=1000
STAKE_PCT_PADRAO=0.02
STAKE_MODO_PADRAO=fixo

# Operacao (Fase 5 e 7)
HORARIO_ENVIO=09:00
INTERVALO_ENVIO_SEGUNDOS=30
ANTECEDENCIA_MINIMA_HORAS=2
QUEUE_ENABLED=true
MAX_ASSINANTES_ATIVOS=50
OPERADOR_NOME=console
DIVERGENCIA_ODD_ALERTA_PCT=0.10
